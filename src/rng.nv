// rng.nv — random numbers from the operating system's generator, and
// from a seedable one.
//
// A cryptographically secure pseudorandom number generator (CSPRNG) is
// a generator whose output no practical computation can tell apart from
// random.  An observer holding part of the output can recover neither
// the rest of it nor what came before.  `OsRandom` reads the operating
// system's, through the character device `/dev/urandom`.  It cannot be
// seeded, and it is the only source here fit for a key, a token, a
// nonce or a password salt.  Every call on it can fail, because it is a
// file.
//
// `Rng` is xoshiro256**, whose whole state is four 64-bit words.  It is
// fast, it passes the statistical test suites its authors run, and it
// is not cryptographically secure.  An observer who has seen a handful
// of its outputs can compute the rest of the stream.  It is here
// because a test, a simulation and a shuffled fixture all need the same
// numbers twice, which is exactly what a secure generator refuses to
// give.
//
// Choosing between the two is one question.  Does anyone gain anything
// by predicting this number?  If the answer is yes, the source is
// `OsRandom`.  If the answer is no, the source is `Rng`, seeded from a
// constant so that a failure can be replayed.
//
// Both sources answer `u64`, `range(lo, hi)`, `fill(dst, n)` and
// `bytes(n)`, with the same meanings, so moving a program from one to
// the other changes the construction and nothing else.  Each of those
// carries a worked example below.
//
// One 64-bit draw from `Rng` is five exclusive-ors, two shifts, two
// rotations and two multiplications, with no allocation and no system
// call.  A `fill` spends one draw per eight bytes.  One draw from
// `OsRandom` is a `read` on an open file, so a caller drawing
// repeatedly holds the handle rather than calling a one-shot form in a
// loop, which opens and closes the device every time.
//
// The operating system source is `/dev/urandom`, so `OsRandom` works
// where that file does.  Linux, macOS and the BSDs are three such
// places.  A target without the file has no `OsRandom` and seeds `Rng`
// from whatever value it has, such as a hardware entropy peripheral.
// `Rng` itself is arithmetic on `Int` and needs neither a heap nor an
// operating system.

use std.bytes
use std.fs
use std.int
use std.list

// The operating system's generator, as a file.  This path is the reason
// half of this module runs only where that file exists.
fn device_path() -> Str
    "/dev/urandom"

// How many bytes one 64-bit draw supplies.
fn word_bytes() -> Int
    8

// ── The operating system's generator ─────────────────────────────────

// An open handle on the operating system's CSPRNG.
//
// Holding one turns a draw into a single `read`.  The one-shot
// functions below open and close the device per call, which is right
// for a token drawn once and wrong for a loop.  A handle owns a file
// descriptor and a process has a finite number of those, so `close` it.
// Nothing here closes it for you.  `os_open` is what answers one.
pub struct OsRandom
    fd: Int

// Open the operating system's generator, or answer `None` where there
// is no such device.
//
// The answer is `None` on every target without a `/dev/urandom`, and
// that is the whole answer.  There is deliberately no fallback to a
// seeded generator, because a caller asking for unpredictable bytes
// would then get predictable ones with nothing saying so.
//
// ```novo
// use rng
//
// // This example writes its own `main`, because reading the device
// // needs more than `[io]`.
// fn main() [io, fs, rand]
//     match rng.os_open()
//         None    => println("no /dev/urandom on this target")
//         Some(o) =>
//             // One handle, two draws, one close.
//             println("${bytes.len(o.bytes(16) ?? bytes.zeros(0))}")   // 16
//             println("${(o.range(1, 7) ?? 0) >= 1}")                  // true
//             o.close()
// ```
pub fn os_open() -> ?OsRandom [fs, rand]
    match fs.open_read(device_path())
        None     => None
        Some(fd) => Some(OsRandom { fd: fd })

impl OsRandom
    // Draw `n` random bytes, or answer `None` if the device would not
    // supply them.
    //
    // An `n` of 0 or less is an empty buffer rather than a refusal.  A
    // caller that computed a length of zero asked for nothing and got
    // nothing.  A short read is `None` and never a partly filled
    // buffer, because half a key is not a key and a caller that could
    // not tell would ship the difference.  See `os_open` for the
    // example.
    fn bytes(self, n: Int) -> ?Bytes [fs, rand]
        if n <= 0
            Some(bytes.zeros(0))
        else
            // The offset is ignored by a character device, which is
            // what `/dev/urandom` is.  Every read draws fresh bytes.
            match fs.read_at(self.fd, 0, n)
                None     => None
                Some(bs) =>
                    if list.len(bs) == n
                        Some(bytes.from_byte_list(bs))
                    else
                        None

    // Write `n` random bytes at the cursor, and answer whether it
    // worked.
    //
    // The answer is `false` when the device would not supply them, and
    // then nothing was written.  The buffer is exactly as the caller
    // left it, so a failed fill cannot be mistaken for a filled one.
    fn fill(self, mut dst: Cursor, n: Int) -> Bool [fs, rand]
        match self.bytes(n)
            None    => false
            Some(b) =>
                dst.put_bytes(b)
                true

    // Draw one 64-bit value, as the bit pattern of an unsigned number.
    //
    // Half the answers are therefore negative `Int`s, and that is the
    // value rather than a fault.  The answer is `None` when the device
    // stopped answering.
    fn u64(self) -> ?Int [fs, rand]
        match self.bytes(word_bytes())
            None    => None
            Some(b) => bytes.u64_be_at(b, 0)

    // Draw a value in `[lo, hi)`, uniformly and with no modulo bias.
    //
    // The answer is `lo` when the range is empty, which matches
    // `Rng.range`, so a caller that computed an empty range gets a
    // value rather than a panic.  It is `None` when the device stopped
    // answering.  A draw landing in the ragged tail above the last
    // whole multiple of the span is discarded and another taken, which
    // is what uniformity costs.  See `os_open` for the example.
    fn range(self, lo: Int, hi: Int) -> ?Int [fs, rand]
        if hi <= lo
            Some(lo)
        else
            let span = hi - lo
            let ceiling = tail_free_ceiling(span)
            var answer: ?Int = None
            var drawing = true
            while drawing
                match self.u64()
                    None    =>
                        drawing = false
                    Some(v) =>
                        let d = positive_of(v)
                        // A draw in the ragged tail above the last whole
                        // multiple of `span` is discarded, not folded.
                        if d < ceiling
                            answer = Some(lo + d % span)
                            drawing = false
            answer

    // Give the device back.
    //
    // A handle that outlives its use holds a file descriptor, and a
    // process has a finite number of those.  Nothing closes it for you.
    // Drawing after a close is a read on a closed descriptor, which
    // answers `None` rather than stopping the program, and is a mistake
    // either way.
    fn close(self) [fs]
        fs.close(self.fd)

// Draw `n` random bytes from the operating system, opening and closing
// the device around the read.
//
// This is the form for a token, a salt or a nonce drawn once.  A caller
// drawing repeatedly holds an `OsRandom` instead, because this opens
// and closes the device on every call, which is a pair of system calls
// per draw.
//
// ```novo
// use rng
//
// // This example writes its own `main`, because reading the device
// // needs more than `[io]`.
// fn main() [io, fs, rand]
//     match rng.os_bytes(32)
//         Some(token) => println("${bytes.len(token)}")   // 32
//         None        => println("no /dev/urandom on this target")
// ```
pub fn os_bytes(n: Int) -> ?Bytes [fs, rand]
    match os_open()
        None    => None
        Some(o) =>
            let drawn = o.bytes(n)
            o.close()
            drawn

// Draw one 64-bit value from the operating system, opening and closing
// the device around the read.
//
// This is `os_bytes` with the eight bytes read as a number, and it
// carries the same warning.  A caller drawing more than once holds an
// `OsRandom`.  Half the answers are negative `Int`s, because the eight
// bytes are a bit pattern rather than a magnitude.
pub fn os_u64() -> ?Int [fs, rand]
    match os_bytes(word_bytes())
        None    => None
        Some(b) => bytes.u64_be_at(b, 0)

// ── The reproducible generator ───────────────────────────────────────

// xoshiro256**, whose whole state is these four words.
//
// It is not cryptographically secure.  An observer who has seen a
// handful of outputs can compute the rest of the stream, so nothing
// that anyone gains by predicting should come from one.  Seed it from a
// constant to replay a run, or from `from_os` when the stream should
// differ per process but need not be unguessable.  `seeded` and
// `from_os` are what answer one.  The methods are `u64`, `positive`,
// `range`, `fill` and `bytes`.
pub struct Rng
    var s0: Int
    var s1: Int
    var s2: Int
    var s3: Int

// Build a generator whose stream is fixed by `seed`.
//
// The same seed gives the same numbers on every machine and every
// backend, which is why this stands beside the operating system's
// generator.  A failing test that shuffled its fixture can be run again
// and fail the same way.  It cannot fail and it reads nothing, so it
// declares no effects and a caller that declares none can call it.
//
// ```novo
// // The same seed gives the same stream, every time it is built.
// var a = rng.seeded(20260905)
// var b = rng.seeded(20260905)
// println("${a.u64() == b.u64()}")           // true
//
// // Neighbouring seeds do not give neighbouring streams, because
// // splitmix64 spreads the seed across the state first.
// println("${rng.seeded(1).u64() != rng.seeded(2).u64()}")   // true
// ```
pub fn seeded(seed: Int) -> Rng
    // splitmix64 is the seeding routine xoshiro's authors specify.  It
    // is here rather than a seed stored in `s0` because the state must
    // not start nearly empty.  A state of a single set bit takes a long
    // run to diffuse, so `seeded(1)` and `seeded(2)` would otherwise
    // open with almost the same numbers.
    let a = split_step(seed)
    let b = split_step(a)
    let c = split_step(b)
    let d = split_step(c)
    Rng { s0: split_value(a), s1: split_value(b),
          s2: split_value(c), s3: split_value(d) }

// Build a generator seeded from the operating system, so that its
// stream differs per process.
//
// It is still not cryptographically secure.  The seed is unguessable
// and the stream that follows it is not, so this is for a run that
// should vary rather than for anything an observer must not predict.
// The answer is `None` where there is no `/dev/urandom`.
//
// ```novo
// use rng
//
// // This example writes its own `main`, because seeding from the
// // device needs more than `[io]`.
// fn main() [io, fs, rand]
//     match rng.from_os()
//         None    => println("no /dev/urandom on this target")
//         Some(r) =>
//             var g = r
//             println("${g.range(1, 7) >= 1}")   // true
// ```
pub fn from_os() -> ?Rng [fs, rand]
    match os_u64()
        None    => None
        Some(v) => Some(seeded(v))

impl Rng
    // Draw the next 64-bit value, as the bit pattern of an unsigned
    // number.
    //
    // Half the answers are negative `Int`s, and that is the value
    // rather than a fault.  The draw is 64 bits and an `Int` is 64
    // bits, so there is nowhere for a sign to go.  `positive` is the
    // same draw with its top bit dropped, and is what everything that
    // counts or indexes should use.
    //
    // ```novo
    // // The seed fixes the stream, so these two lines print these two
    // // numbers.
    // var r = rng.seeded(1)
    // println("${r.u64()}")   // -5480124913605472059
    // println("${r.u64()}")   // -8846382939111011094
    // ```
    fn u64(mut self) -> Int
        // The two stars of xoshiro256** name the scrambler.  The output
        // is a scrambled view of one state word, and the state advances
        // on its own, so a weakness in either does not reach the other.
        let result = int.wrapping_mul(rotl(int.wrapping_mul(self.s1, 5), 7), 9)
        let t = self.s1 << 17
        self.s2 ^= self.s0
        self.s3 ^= self.s1
        self.s1 ^= self.s2
        self.s0 ^= self.s3
        self.s2 ^= t
        self.s3 = rotl(self.s3, 45)
        result

    // Draw a non-negative value.  It is the next 64-bit draw with its
    // top bit dropped, so 63 random bits.
    //
    // Everything that counts or indexes goes through this, so the
    // arithmetic above it is ordinary arithmetic on a signed `Int`
    // rather than unsigned arithmetic wearing one.  It consumes one
    // draw, like `u64`.
    //
    // ```novo
    // var r = rng.seeded(42)
    // println("${r.positive() >= 0}")   // true
    // ```
    fn positive(mut self) -> Int
        positive_of(self.u64())

    // Draw a value in `[lo, hi)`, uniformly.
    //
    // The answer is `lo` when the range is empty, so a caller that
    // computed an empty range gets a value rather than a panic.
    // `hi - lo` must fit an `Int`.  A draw landing in the ragged tail
    // above the last whole multiple of the span is discarded and
    // another taken, rather than folded with `%`.  Folding would favour
    // the low values, invisibly for a die and totally for a span near
    // the top of the range.  A call therefore consumes one draw or
    // more.
    //
    // ```novo
    // // A die that can be replayed: the same seed rolls the same
    // // numbers.
    // var r = rng.seeded(20260905)
    // println("${r.range(1, 7)} ${r.range(1, 7)} ${r.range(1, 7)}")   // 2 3 2
    //
    // // An empty range is its own low end, not a panic.
    // println("${r.range(5, 5)}")   // 5
    // ```
    fn range(mut self, lo: Int, hi: Int) -> Int
        if hi <= lo
            lo
        else
            let span = hi - lo
            let ceiling = tail_free_ceiling(span)
            var d = self.positive()
            // A draw in the ragged tail above the last whole multiple of
            // `span` is discarded, not folded.
            while d >= ceiling
                d = self.positive()
            lo + d % span

    // Write `n` random bytes at the cursor.  It writes into the
    // caller's buffer and allocates nothing.
    //
    // It spends one draw per eight bytes, plus one more for a tail
    // shorter than that.  The unused part of the tail draw is discarded
    // rather than carried, so a fill never depends on how the previous
    // one ended.  That is what makes two fills of four bytes differ
    // from one fill of eight.  What repeats is the position in the
    // stream rather than the bytes.
    //
    // ```novo
    // use std.bytes
    //
    // var r = rng.seeded(1)
    // var out = bytes.cursor_be(bytes.zeros(12))
    // r.fill(out, 12)
    // println(bytes.to_hex(out.finish()))
    // // b3f2af6d0fc710c5ea4c3647
    // ```
    fn fill(mut self, mut dst: Cursor, n: Int)
        var remaining = n
        while remaining >= word_bytes()
            dst.put_u64(self.u64())
            remaining = remaining - word_bytes()
        // The tail takes the low bytes of one more draw.  The rest of
        // that draw is discarded rather than carried, so a `fill` never
        // depends on how the previous one ended.
        if remaining > 0
            var word = self.u64()
            for _i in 0..remaining
                dst.put_u8(word & 0xff)
                word >>>= 8

    // Draw `n` random bytes as a fresh buffer.
    //
    // This is `fill` with the buffer allocated for you, for a caller
    // building a fixture rather than filling a frame it already owns.
    //
    // ```novo
    // use std.bytes
    //
    // var r = rng.seeded(7)
    // println("${bytes.len(r.bytes(5))}")   // 5
    // ```
    fn bytes(mut self, n: Int) -> Bytes
        var c = bytes.cursor_be(bytes.zeros(n))
        self.fill(c, n)
        c.finish()

// ── The arithmetic, on `Int` alone ───────────────────────────────────

// `x` rotated left by `k` bits.
//
// It is written from the shifts rather than with `bits.rotate_left`,
// which the interpreter does not implement, so that the compiler and
// the interpreter run the same source.
fn rotl(x: Int, k: Int) -> Int
    // The count is named because the shifts bind looser than `-`, so
    // the inline form would read as a shift by 64 followed by a
    // subtraction.
    let back = 64 - k
    (x << k) | (x >>> back)

// The bit pattern of `v` with its top bit dropped.  It is a
// non-negative `Int` carrying 63 random bits.
fn positive_of(v: Int) -> Int
    v >>> 1

// The last whole multiple of `span` that a 63-bit draw can reach.  Both
// `range` functions discard a draw at or above it and take another.
//
// A plain `draw % span` favours the low residues whenever `span` does
// not divide the draw's range.  The bias is invisible for a die and
// total for a span near the top of the range.  Discarding the tail
// instead costs an expected `span / 2^63` extra draws, which is nothing
// for any span a caller actually asks for.
fn tail_free_ceiling(span: Int) -> Int
    let all_ones = 0 - 1
    let largest_draw = all_ones >>> 1
    largest_draw / span * span

// splitmix64's three constants, each assembled from its two halves.
//
// They are written this way rather than as one literal because all
// three are above 2^63, where an `Int` literal has to be spelled as the
// negative decimal with that bit pattern.  The whole value of these
// numbers is that a reader can set them beside the ones the algorithm
// publishes, and those are always given in hexadecimal.

// The increment, `0x9e3779b97f4a7c15`.  It is the golden ratio's
// fractional part scaled to 64 bits, and it is odd, so stepping by it
// visits every state.
fn golden_gamma() -> Int
    joined(0x9e3779b9, 0x7f4a7c15)

// The first mixing multiplier, `0xbf58476d1ce4e5b9`.
fn first_multiplier() -> Int
    joined(0xbf58476d, 0x1ce4e5b9)

// The second mixing multiplier, `0x94d049bb133111eb`.
fn second_multiplier() -> Int
    joined(0x94d049bb, 0x133111eb)

// A 64-bit constant from its high and low 32-bit halves.
fn joined(high: Int, low: Int) -> Int
    (high << 32) | low

// One step of splitmix64's state.  It adds the seeding routine's odd
// increment, which is chosen so that every seed reaches a different
// part of the sequence.
fn split_step(state: Int) -> Int
    int.wrapping_add(state, golden_gamma())

// The value splitmix64 produces from a state.  It is two rounds of
// multiply, exclusive-or and shift, which is what spreads one set bit
// across all 64.
fn split_value(state: Int) -> Int
    var z = state
    z = int.wrapping_mul(z ^ (z >>> 30), first_multiplier())
    z = int.wrapping_mul(z ^ (z >>> 27), second_multiplier())
    z ^ (z >>> 31)
